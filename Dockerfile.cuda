# syntax=docker/dockerfile:1.7

# The cuda-legacy image (Maxwell/Pascal, e.g. TITAN X) overrides CUDA_IMAGE, TORCH_EXTRA and
# SPEAKRS_VARIANT with a CUDA 12.4 base, the cu126 torch build and the sm_52 speakrs build;
# see compose.yaml.
ARG CUDA_IMAGE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
# Built from Dockerfile.speakrs.
ARG SPEAKRS_IMAGE=ghcr.io/maroonbrian1928/parakeetx-speakrs:v3@sha256:eb7dd52d7d22e171629a6309a9fd8041fe11925d9c06a3515a72a0753c15a650

FROM ${SPEAKRS_IMAGE} AS speakrs

FROM ${CUDA_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON=3.12 \
    UV_PYTHON_PREFERENCE=managed

# cuda (cu128 torch) or cuda-legacy (cu126 torch); see pyproject.toml.
ARG TORCH_EXTRA=cuda
# GitHub Actions sets --no-cache to reduce peak disk use.
ARG UV_SYNC_FLAGS=

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip curl build-essential libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync ${UV_SYNC_FLAGS} --frozen --no-dev --no-install-project \
    --extra nemo --extra diarization --extra vad --extra forced-alignment --extra ${TORCH_EXTRA}

FROM ${CUDA_IMAGE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/src" \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /root/.local/share/uv/python /root/.local/share/uv/python

# speakrs diarization backend (DIARIZATION__BACKEND=speakrs).
# cuda12 = upstream speakrs + official ONNX Runtime 1.28 (sm_60+, needs a CUDA >= 12.5 runtime, so not
# the cuda-legacy 12.4 base); sm52 = patched build on ONNX Runtime 1.20.1 for Maxwell (also runs on Pascal via JIT).
ARG SPEAKRS_VARIANT=cuda12
COPY --from=speakrs /opt/speakrs/models /opt/speakrs/models
COPY --from=speakrs /opt/speakrs/${SPEAKRS_VARIANT} /opt/speakrs

COPY src ./src

EXPOSE 7474
CMD ["sh", "-c", "uvicorn parakeetx_api_server.main:app --host ${UVICORN_HOST:-0.0.0.0} --port ${UVICORN_PORT:-7474}"]

# syntax=docker/dockerfile:1.7

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON=3.12 \
    UV_PYTHON_PREFERENCE=managed

ARG TORCH_VERSION=2.5.1
ARG TORCHAUDIO_VERSION=2.5.1
ARG PYTORCH_CUDA_FLAVOR=cu118
ARG UV_TORCH_INSTALL_FLAGS=

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv python3-pip curl build-essential libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --no-install-project --extra nemo --extra diarization --extra vad --extra forced-alignment --extra cuda \
    --no-install-package torch \
    --no-install-package torchaudio

# Legacy CUDA build for Maxwell/Pascal-era GPUs that are not covered by newer cu128 wheels.
# GitHub Actions can set UV_TORCH_INSTALL_FLAGS=--no-cache to reduce peak disk use.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install ${UV_TORCH_INSTALL_FLAGS} --python /app/.venv/bin/python \
    --index-url "https://download.pytorch.org/whl/${PYTORCH_CUDA_FLAVOR}" \
    "torch==${TORCH_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}"

# Patch NeMo's RNNT segment-timestamp IndexError. _get_segment_offsets indexes
# word[-1] without guarding against an empty decoded word, so certain audio raises
# "IndexError: string index out of range", which the API surfaces as HTTP 422.
# The line is unguarded in NeMo 2.3.0 (what the cu118 lockfile resolves here).
# Upstream NeMo added the `word and ...` guard in 2.4.0, but we can't move to it on
# this build: qwen-asr pins transformers==4.57.6 while NeMo>=2.4 needs
# transformers<4.54. See https://github.com/MaroonBrian1928/parakeetX/issues/9
# No-op on NeMo versions that already ship the guard (patched count is 0).
RUN python3 <<'PATCH'
import pathlib
init = next(pathlib.Path("/app/.venv").rglob("site-packages/nemo/__init__.py"), None)
assert init is not None, "nemo not found in venv"
base = init.parent
old = "elif word[-1] in segment_delimiter_tokens or word in segment_delimiter_tokens:"
new = "elif word and (word[-1] in segment_delimiter_tokens or word in segment_delimiter_tokens):"
patched = 0
for f in base.rglob("*.py"):
    text = f.read_text()
    if old in text:
        f.write_text(text.replace(old, new))
        patched += 1
        print("patched", f)
# Fail the build if any unguarded occurrence remains (guards against silent misses).
for f in base.rglob("*.py"):
    assert old not in f.read_text(), f"unguarded segment-offset line remains in {f}"
print(f"NeMo RNNT guard patch complete ({patched} file(s) changed)")
PATCH

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH="/app/src" \
    PATH="/app/.venv/bin:${PATH}"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libsndfile1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /root/.local/share/uv/python /root/.local/share/uv/python
COPY src ./src

EXPOSE 7474
CMD ["sh", "-c", "uvicorn parakeetx_api_server.main:app --host ${UVICORN_HOST:-0.0.0.0} --port ${UVICORN_PORT:-7474}"]

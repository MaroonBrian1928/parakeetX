# Authentication
API_KEY=

# Hugging Face token (required for diarization model download/use)
HF_TOKEN=

# Parakeet config
PARAKEET__MODEL_NAME=nvidia/parakeet-tdt-0.6b-v2
PARAKEET__PRELOAD_MODEL=false
PARAKEET__LOCAL_FILES_ONLY=false
PARAKEET__CUDA_HALF_PRECISION=true
PARAKEET__CUDA_ADAPTIVE_CHUNKING=true
PARAKEET__CUDA_FORCE_GREEDY_DECODING=false
PARAKEET__CUDA_CHUNK_SECONDS_OVERRIDE=
PARAKEET__CUDA_CHUNK_MIN_SECONDS=30
PARAKEET__CUDA_CHUNK_MAX_SECONDS=600
PARAKEET__CUDA_CHUNK_OVERLAP_SECONDS=0.0
PARAKEET__CUDA_VAD_BATCH_SIZE=8
PARAKEET__CUDA_TORCH_COMPILE=false
PARAKEET__USE_EXTRACTED_NEMO_CACHE=false
PARAKEET__TORCH_LOAD_MMAP=false

# Diarization config
DIARIZATION__MODEL_NAME=pyannote/speaker-diarization-community-1
DIARIZATION__PRELOAD_MODEL=false
DIARIZATION__SEGMENTATION_BATCH_SIZE=64
DIARIZATION__EMBEDDING_BATCH_SIZE=64
# Convert pyannote segmentation + embedding submodules to FP16 on CUDA. Negligible
# accuracy impact, ~1.5-2x faster on the embedding pass.
DIARIZATION__CUDA_HALF_PRECISION=false

# VAD config
VAD__ENABLED=true
VAD__METHOD=silero
VAD__PRELOAD_MODEL=false
# auto | cpu | cuda. cuda forces JIT backend (ONNX wrapper is CPU-only).
VAD__DEVICE=auto
VAD__USE_ONNX=true
VAD__ONNX_FALLBACK_TO_JIT=true
VAD__ONNX_OPSET_VERSION=16
VAD__VAD_ONSET=0.5
VAD__VAD_OFFSET=0.363
VAD__CHUNK_SIZE=30
VAD__MIN_SPEECH_DURATION_MS=250
VAD__MIN_SILENCE_DURATION_MS=100
VAD__SPEECH_PAD_MS=200

# Forced alignment config
# parakeet uses native Parakeet word timestamps; qwen uses Qwen/Qwen3-ForcedAligner-0.6B.
FORCED_ALIGNMENT__ENABLED=true
FORCED_ALIGNMENT__METHOD=qwen
FORCED_ALIGNMENT__MODEL_NAME=Qwen/Qwen3-ForcedAligner-0.6B
FORCED_ALIGNMENT__DEVICE=cuda
FORCED_ALIGNMENT__DTYPE=bfloat16
FORCED_ALIGNMENT__ATTN_IMPLEMENTATION=
FORCED_ALIGNMENT__MAX_CHUNK_SECONDS=30
FORCED_ALIGNMENT__BATCH_SIZE=4
FORCED_ALIGNMENT__PRELOAD_MODEL=false

# API runtime
MAX_CONCURRENT_TRANSCRIPTIONS=1
DEBUG_LOG_TRANSCRIPTION_PAYLOAD=false
MODEL_IDLE_EVICT_MINUTES=1
MODEL_PROCESS_ISOLATION=true
UNLOAD_ASR_BEFORE_DIARIZATION=false
UNLOAD_ASR_BEFORE_FORCED_ALIGNMENT=false
# Release reserved-but-unallocated GPU memory back to the driver after each stage.
# Helps when ASR/diarization run in an isolated worker process and FA runs in-process.
EMPTY_CUDA_CACHE_AFTER_STAGE=false
UVICORN_HOST=0.0.0.0
UVICORN_PORT=7474
HOST_PORT=7474

# CUDA profile overrides (compose.yaml and compose.cuda-legacy.yaml)
PARAKEET__DEVICE_CUDA=cuda
DIARIZATION__DEVICE_CUDA=cuda
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
